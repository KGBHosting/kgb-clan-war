; KGB Clan War core configuration.
; Existing server configs are never overwritten by the installer.
kgb_cw_enabled 1

; In-game presentation. Unsafe, empty, or overlong values fall back to the
; package defaults instead of being rendered.
kgb_cw_display_name "KGB Clan War"
kgb_cw_chat_prefix "[KGB CW]"

kgb_cw_min_ready 10
kgb_cw_ready_mode "player"
kgb_cw_auto_live 0
kgb_cw_format "mr"
kgb_cw_half_rounds 15
kgb_cw_win_rounds 16
kgb_cw_time_limit_minutes 20
kgb_cw_playout 0
kgb_cw_overtime 1
; Set to 0 only when deliberately allowing unlimited overtime cycles.
kgb_cw_overtime_max_cycles 3
kgb_cw_overtime_half_rounds 3
kgb_cw_overtime_money 10000
; When enabled, connected players vote to play overtime or accept the draw.
; A tied/no-vote result uses kgb_cw_overtime_vote_default.
kgb_cw_overtime_vote 0
kgb_cw_overtime_vote_seconds 15
kgb_cw_overtime_vote_default 1
kgb_cw_hud_announcements 1
; Recurring ready/score HUD when HUD announcements are enabled. Set 0 to
; disable; otherwise clamped to 3-60 sec.
kgb_cw_hud_interval 10

; Team and series metadata.
kgb_cw_team_a_name "Team A"
kgb_cw_team_b_name "Team B"
kgb_cw_team_a_tag ""
kgb_cw_team_b_tag ""
kgb_cw_map1 ""
kgb_cw_map2 ""
kgb_cw_map_count 1

; Each phase config is a validated basename under cstrike/. Do not include a
; path or .cfg suffix. KGB Panel recipes supply kgb_gamemode.cfg.
kgb_cw_warmup_config "kgb_gamemode"
kgb_cw_match_config "kgb_gamemode"
kgb_cw_overtime_config "kgb_gamemode"
kgb_cw_default_config "kgb_gamemode"
kgb_cw_halftime_delay 5
kgb_cw_second_half_ready 0
; halves = automatic side swaps, off = teams retain their sides.
kgb_cw_swap_policy "halves"
kgb_cw_knife_vote 1
kgb_cw_knife_vote_seconds 15
kgb_cw_pug_mode 0
kgb_cw_pug_style "random"
; Keep an active PUG session across the configured second map and return to
; warmup after match completion.
kgb_cw_pug_persist 1
; Allows the admin menu to write only a non-secret, allowlisted snapshot to
; addons/amxmodx/configs/kgb_clan_war_saved.cfg.
kgb_cw_allow_menu_save 0

; Risky, access-changing, or client-affecting features are opt-in.
kgb_cw_set_hostname 0
kgb_cw_hostname ""
kgb_cw_set_password 0
kgb_cw_password ""
kgb_cw_disable_shield 0
kgb_cw_client_demos 0
kgb_cw_screenshots 0
; Explicit admin-only score/SteamID MOTD plus screenshot workflow.
kgb_cw_scoreid_screenshots 0
kgb_cw_file_stats 1
